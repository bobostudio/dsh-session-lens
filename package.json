{
  "name": "dsh-session-lens",
  "description": "Session insights and one-click shareable HTML replay for DeepSeek Harness (DSH) · DeepSeek Harness 会话洞察与一键分享插件",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobostudio/dsh-session-lens.git"
  },
  "homepage": "https://github.com/bobostudio/dsh-session-lens#readme",
  "bugs": "https://github.com/bobostudio/dsh-session-lens/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "analytics"
  ],
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./analytics": "./lib/analytics.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
